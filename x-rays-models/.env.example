# Flask ML service config. Copy to .env and adjust if needed — all of these
# have safe defaults baked into app.py, so this file only matters if you
# want to change something.

# Host to bind to. Leave as 127.0.0.1 for local dev / same-host deployment
# with Node (this is what keeps the service from being reachable directly
# from outside). Only set to 0.0.0.0 if you know Node and Flask will be in
# separate containers/hosts, and add your own auth between them first.
FLASK_HOST=127.0.0.1

# Port Flask listens on. Must match FLASK_URL in the Node .env.
PORT-xray=5000

# Never set this to true outside local dev — Werkzeug's debugger is a known
# remote-code-execution vector if this process is ever reachable externally.
FLASK_DEBUG=false

# Score above which the Keras classifier's output counts as "this is an
# x-ray" (0.0-1.0).
X_RAY_THRESHOLD=0.8
