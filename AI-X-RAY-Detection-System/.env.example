MONGO_URI=mongodb://localhost:27017/xray_app
SESSION_SECRET=change_this_to_a_long_random_string

# Node server port (active.js already falls back to 3000 if unset)
PORT=3000

# Base URL of the Flask ML service (see x-rays-models/.env for its own port)
FLASK_URL=http://127.0.0.1:5000

# Cloudinary — where uploaded x-rays, generated heatmaps, and PDF reports are
# stored (see config/cloudinary.js). Needed because most free-tier hosts
# (Render's free web service included) wipe local disk on every
# restart/redeploy, so files can't just live in public/uploads anymore.
# Get these from your Cloudinary dashboard after signing up (free tier).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
