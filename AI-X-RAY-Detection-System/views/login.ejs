<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Signup/Login</title>
<link rel="stylesheet" href="./stylesheets/loginstyle.css">
</head>
<%
  // These locals aren't always passed (e.g. the plain GET / render only
  // sends csrfToken), so default them here instead of at every call site.
  var error = typeof error !== 'undefined' ? error : null;
  var activeForm = typeof activeForm !== 'undefined' ? activeForm : 'register';
  var oldInput = typeof oldInput !== 'undefined' && oldInput ? oldInput : {};
%>
<body>
 <div class="left">
    <img src="https://img.icons8.com/ios-filled/50/00ffe7/fire-element.png" width="30" alt="logo" style="margin-bottom: 20px;" />
    <h2 id="form-title"><%= activeForm === 'login' ? 'Login to your account' : 'Create an account' %></h2>
    <p id="form-subtitle"><%= activeForm === 'login' ? 'Welcome back. Enter your credentials to continue.' : 'Let’s get started with your 30-day free trial.' %></p>

   <div class="form-group<%= activeForm === 'register' ? ' active' : '' %>" id="register-form">
  <form action="/register" method="post" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <% if (error && activeForm === 'register') { %>
      <div class="form-error"><%= error %></div>
    <% } %>
    <input type="text" placeholder="Name" name="name" value="<%= oldInput.name || '' %>" maxlength="60" required/>
    <input type="email" placeholder="Email" name="email" value="<%= oldInput.email || '' %>" required/>
    <input type="number" placeholder="Age" min="1" max="120" name="age" value="<%= oldInput.age || '' %>" required/>
<select name="gender" required style="
  width: 100%;
  padding: 12px 15px;
  background-color: #121212;
      border: 1px solid #333;
      border-radius: 8px;
  color: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10px);
  font-size: 1rem;
  margin-bottom: 15px;
  outline: none;
  appearance: none;
  -webkit-appearance: none;
  background-image: url('data:image/svg+xml;utf8,<svg fill=\'%2300ffe7\' height=\'20\' viewBox=\'0 0 24 24\' width=\'20\' xmlns=\'http://www.w3.org/2000/svg\'><path d=\'M7 10l5 5 5-5z\'/></svg>');
  background-repeat: no-repeat;
  background-position: right 10px center;
  background-size: 20px;
">
  <option value="" disabled <%= !oldInput.gender ? 'selected' : '' %>>Select Gender</option>
  <option value="male" <%= oldInput.gender === 'male' ? 'selected' : '' %>>Male</option>
  <option value="female" <%= oldInput.gender === 'female' ? 'selected' : '' %>>Female</option>
  <option value="other" <%= oldInput.gender === 'other' ? 'selected' : '' %>>Other</option>
</select>
    <input type="password" placeholder="Password (min 8 characters, letters + numbers)" name="password" minlength="8" required/>
    <input type="submit" value="Create Account" >
  </form>
</div>

    <!-- Login Form -->
    <div class="form-group<%= activeForm === 'login' ? ' active' : '' %>" id="login-form">
      <form action="/login" method="post" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if (error && activeForm === 'login') { %>
        <div class="form-error"><%= error %></div>
      <% } %>
      <input type="email" placeholder="Email" name="loginemail" value="<%= oldInput.loginemail || '' %>" required/>
      <input type="password" placeholder="Password" name="loginpassword" required/>
      <input type="submit" value="Login">
      </form>
    </div>

    <small>
      <span id="toggle-text"><%= activeForm === 'login' ? "Don’t have an account?" : 'Already have an account?' %></span>
      <a onclick="toggleForm()" id="toggle-link"><%= activeForm === 'login' ? 'Sign up' : 'Login' %></a>
    </small>
  </div>

  <div class="right">
    <video autoplay muted loop>
      <source src="./videos/skeli.mp4" type="video/mp4" />
      Your browser does not support video.
    </video>

    <div class="overlay">
      <p>“Untitled Labs were a breeze to work alongside, we can’t recommend them enough. We launched 6 months earlier than expected and are growing 30% MoM.”</p>
      <h4>Amélie Laurent<br><small>Founder, Sisyphus</small></h4>
    </div>
  </div>
<script>
  // Tells loginform.js which panel the server already rendered as active
  // (e.g. it re-rendered the login panel after a failed login attempt),
  // so the very first toggle click flips the right direction.
  window.__initialFormIsLogin = <%- activeForm === 'login' ? 'true' : 'false' %>;
</script>
<script src="./javascripts/loginform.js" defer></script>
</body>
</html>
