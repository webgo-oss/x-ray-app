  <div class="section2" id="upload">
    <div class="left_file_block file_block">
      <div class="sub_file_block sub1">
        <div class="child_block_one">
           <div class="uploads">
           <span>upload x-rays</span>
           <p> Upload a clear X-ray image (JPG or PNG) for quick analysis. Your data stays private</p>
           <form action="/analyze" method="post" enctype="multipart/form-data">
           <input type="file" id="file" name="xray" accept="image/*" required>
           <label for="file" class="custom-label">Upload X-Ray</label>
             <button type="submit" class="custom-label-ana">Analyze<i class="bi bi-arrow-right"></i></button>
           </form>
           </div>
           <div class="images_upload">
 <img src="./images/x-ray.png" >
