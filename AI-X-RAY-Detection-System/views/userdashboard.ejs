<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>DASHBOARD</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Abel&family=Anton&family=Architects+Daughter&family=Archivo+Black&family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Bungee+Inline&family=Cedarville+Cursive&family=Comic+Neue:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&family=Cutive+Mono&family=Edu+AU+VIC+WA+NT+Arrows:wght@400..700&family=Encode+Sans:wght@100..900&family=Fjalla+One&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Josefin+Sans:ital,wght@0,100..700;1,100..700&family=Kenia&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Major+Mono+Display&family=Merriweather:ital,wght@0,300;0,400;0,700;0,900;1,300;1,400;1,700;1,900&family=Montserrat+Underline:ital,wght@0,100..900;1,100..900&family=Mulish:ital,wght@0,200..1000;1,200..1000&family=Nabla&family=Noto+Serif:ital,wght@0,100..900;1,100..900&family=Oswald:wght@200..700&family=Outfit:wght@100..900&family=Oxanium:wght@200..800&family=Parkinsans:wght@300..800&family=Playwrite+FR+Moderne:wght@100..400&family=Playwrite+HR+Lijeva:wght@100..400&family=Playwrite+ID+Guides&family=Proza+Libre:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500;1,600;1,700;1,800&family=Righteous&family=Roboto+Condensed:ital,wght@0,100..900;1,100..900&family=Rubik:ital,wght@0,300..900;1,300..900&family=Six+Caps&family=Slabo+27px&family=Sour+Gummy:ital,wght@0,100..900;1,100..900&family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&family=Varela+Round&family=Work+Sans:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">

<link rel="stylesheet" href="./stylesheets/userdashboardstyle.css">
  
</head>
<body>
  <aside class="sidebar">
    <div class="logo">
      <img src="/uploads/<%= user.profile_image || 'default.jpg' %>" >
    </div>
    <nav class="menu">
      <a class="active" onclick="showDashboard()">Overview</a>
      <a href="/nearby-doctors">Nearby Doctors</a>
      <a>soon</a>
      <a>soon</a>
    </nav>
    <div class="settings">
      <a onclick="showProfile()">Profile</a>
      <a>soon</a>
    </div>
    <a class="signout" href="/logout" >Sign Out</a>
  </aside>

  <div class="dashboard">
    <main class="main-content" id="dashboard-content">
      <section class="summary">
        <div class="income">
          <h1> <%= count %></h1>
          <p> system processed so far<br>
            Updated in real-time.
Covers hand, knee, and  elbow.</p>
          <img src="./images/count.png" alt="">
        </div>
        <div class="income">
           <h1>94.6%</h1>
          <p>Accuracy Trained on hand, knee, and elbow X-rays
            on test data</p>
          <img src="./images/ai-model.png" alt="" style="margin-top: 20px;">
        </div>
        <div class="calendar">
          <div class="time-card">
    <div class="day" id="day">tue</div>
    <div class="date" id="date">26<span>th</span></div>
    <div class="time" id="time">09:52</div>
    <div class="ampm" id="ampm">PM</div>
  </div>
        </div>
        <div class="more">
          <i class="bi bi-arrow-up-right-circle"></i>
          <h4>Need to Scan More?</h4>
          <p>Your X-ray scans power the AI engine behind smarter, faster, and more accurate diagnoses.
Each upload helps improve detection of fractures and anomalies in hands, knees, and elbows.</p>
          <button onclick="window.location.href='/main#upload'">more</button>
        </div>
      </section>

      <section class="reservations">
        <h4>history</h4>
<table>
  <tr>
    <th>Original</th>
    <th>Heatmap</th>
    <th>Prediction</th>
    <th>Confidence</th>
    <th>Date & Time</th>
    <th>Action</th>
  </tr>

<% history.forEach(item => { %>
  <tr>
    <td>
      <% if(item.original_image) { %>
        <img src="<%= item.original_image %>" width="100">
      <% } else { %> ❌ <% } %>
    </td>
    <td>
      <% if(item.heatmap_image) { %>
        <img src="<%= item.heatmap_image %>" width="100">
      <% } else { %> ❌ <% } %>
    </td>
    <td><%= item.prediction || 'N/A' %></td>
    <td><%= item.confidence || 'N/A' %>%</td>
    <td><%= new Date(item.created_at).toLocaleString() %></td>
    <td>
      <% if(item.pdf_report) { %>
        <a href="<%= item.pdf_report %>" download>
          <button>📄 Download PDF</button>
        </a>
      <% } else { %>
        ❌
      <% } %>
    </td>
  </tr>
<% }) %>
</table>
      </section>
    </main>
    <section class="profile-section" id="profile-section">
        <!-- <video class="bg-video" autoplay muted playsinline>
    <source src="./videos/user.mp4" type="video/mp4" />
    <source src="./videos/user.mp4" type="video/webm" />
  </video> -->
       <div class="glass-card" id="main-profile">
    <img src="/uploads/<%= user.profile_image || 'default.jpg' %>" alt="Logo" class="logo-image" />
    <div class="content">
      <h4> <%= user.email %> </h4>
      <h1><%= user.name %></h1>
      <p>  Welcome back! Your current profile shows:
      Gender:  <strong style="color:#00f7ff;font-weight: 400;"><%= user.gender %></strong> |
       Age:  <strong style="color:#00f7ff;font-weight: 400;"><%= user.age %></strong></p>
      <button onclick="update()">edit </button>
    </div>
  </div>
  <div class="updateinfo" id="update-profile" style="display: none;">
    <div class="cross">
      <span onclick="done()">X</span>
    </div>
<form action="/updateprofile" method="post" enctype="multipart/form-data" class="profile-form">
  <div class="form-top">
    <div class="image-preview">
      <img src="<%= user.profile_image || 'default.jpg' %>" alt="Profile Image" id="profileImage">
    </div>
    <div class="file-upload">
      <input type="file" name="profilepic" accept="image/*" id="fileInput">
    </div>
  </div>

  <div class="form-group">
    <label for="updateprofilename">Name--</label>
    <input type="text" name="updateprofilename" id="updateprofilename" value="<%= user.name %>" required>
  </div>

  <div class="form-group">
    <label for="gender">Gender--</label>
    <select name="gender" id="gender" required>
      <option value="Male" <%= user.gender==='Male'?'selected':'' %> >Male</option>
      <option value="Female" <%= user.gender==='Female'?'selected':'' %> >Female</option>
      <option value="Other" <%= user.gender==='Other'?'selected':'' %> >Other</option>
    </select>
  </div>

  <div class="form-group">
    <label for="age">Age--</label>
    <input type="number" name="age" id="age" value="<%= user.age %>" min="0" max="122" required>
  </div>

  <button type="submit" class="confirm-btn" onclick="done()">Confirm</button>
</form>

  </div>
    </section>
  </div>
  <script>
    const fileInput = document.getElementById('fileInput');
    const profileImage = document.getElementById('profileImage');

    fileInput.addEventListener('change', function () {
      const file = this.files[0];
      if (file) {
        profileImage.src = URL.createObjectURL(file);
      }
    });
    function update(){
            document.getElementById('main-profile').style.display='none';
      document.getElementById('update-profile').style.display='flex';
    }
    function done(){
                  document.getElementById('main-profile').style.display='flex';
      document.getElementById('update-profile').style.display='none';

    }
  </script>
<script src="./javascripts/userdashboard.js" defer></script>
</body>
</html>

